# ==============================================================================
# PULSE CHAT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local and populate the values for your environment.
# Never commit .env or sensitive credentials to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Connection string to your MongoDB Atlas cluster or local MongoDB instance with replica set.
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://db_user:YOUR_SECURE_PASSWORD@cluster0.example.mongodb.net/pulse_chat_prod?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# A secure 32+ char secret used to encrypt cookies and JWT tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="your-generated-32-byte-base64-secret-here"
AUTH_TRUST_HOST=true

# Canonical URL of the application
# For local dev: http://localhost:3000
# For Vercel: https://your-app-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. REALTIME MESSAGING (Pusher Channels - Vercel Serverless Ready)
# ------------------------------------------------------------------------------
REALTIME_PROVIDER="pusher"
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Alias keys supported by provider abstraction:
REALTIME_API_KEY="your_pusher_key"

# ------------------------------------------------------------------------------
# 3.1 DEDICATED SOCKET.IO SIGNALING & CHAT SERVER (Optional Ultra-Fast WebSocket)
# ------------------------------------------------------------------------------
# For local dev: runs on port 4000 via `npm run socket-server`
# For Vercel/Production: Deploy socket-server.js on Render/Railway/Fly.io (free)
# and paste that server URL here (e.g., https://pulse-chat-socket.onrender.com)
SOCKET_PORT=4000
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 4. FILE & IMAGE STORAGE (Cloudinary / Object Storage)
# ------------------------------------------------------------------------------
# For production media storage. If not configured, the app falls back to secure
# local server-side upload storage handler.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & SECURITY (Optional production tuning)
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"
